{
  "expo": {
    "name": "나만의 냉장고",
    "slug": "fridge-app",
    "version": "1.0.0",
    "scheme": "fridgeapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f7f6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.fridgeapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f5f7f6"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.yourname.fridgeapp",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
[
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#3a9170"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b90a0ca0-8e91-496a-bf3f-ab426e4808ba"
      }
    }
  }
}
